{
  "name": "codemylife-frontend",
  "version": "0.1.71",
  "description": "CodeMyLife desktop app (Electron)",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dev": "tsc -p tsconfig.json -w",
    "test": "tsc -p tsconfig.test.json && node --test dist_test/test/*.test.js",
    "package": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.codemylife.desktop",
    "productName": "CodeMyLife",
    "directories": {
      "output": "dist_electron"
    },
    "publish": {
      "provider": "github",
      "owner": "felaks03",
      "repo": "CodeMyLife",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "include": "installer/setup.nsh"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
